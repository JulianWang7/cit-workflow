# === 产物：正式 / 中间 / 临时 ===
/runs/*
!/runs/.gitkeep
!/runs/README_ARTIFACT_ROOT.md

/runs_work/*
!/runs_work/.gitkeep
!/runs_work/README.md

/tmp/
/.cache/
*.log
*.tmp
*.bak

# === Cursor：共享配置入库；本地态排除 ===
.cursor/*
!.cursor/mcp.json
!.cursor/hooks.json
!.cursor/hooks/
!.cursor/hooks/**
!.cursor/rules/
!.cursor/rules/**
!.cursor/skills/
!.cursor/skills/**

# === 凭据 / IDE / 环境 ===
.env
.env.*
!.env.example
*.pem
*.key
.vscode/
.idea/
*.sqlite
*.sqlite-journal

# === Python ===
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.eggs/
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/

