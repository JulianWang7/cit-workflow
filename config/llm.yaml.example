# LLM 配置模板。复制到 ~/.bugfix-flow/llm.yaml 后改成自己的。
# bugfix-batch 工具默认用此配置（优先级高于 ~/.zcode/v2/config.json）。
# 如果不创建此文件，工具会回退到 ZCode config.json 的第一个可用 provider。

llm:
  model: glm-5.2                              # 模型名
  base_url: http://your-llm-server/v1         # OpenAI 兼容 API 地址
  api_key: ''                                 # API Key

  # ── 向量检索配置（RAG） ──────────────────────────────────
  # 不配以下字段 → 知识库静默降级为纯 SQL LIKE 关键词搜索，不影响使用。
  # 配齐后运行 kb_reindex(kb_type="bug") 建索引，kb_search 即走向量+关键词混合检索。
  embedding_base_url: https://open.bigmodel.cn/api/paas/v4   # embedding API 地址
  embedding_api_key: ''                                      # embedding 专用 key（可与上面 api_key 不同）
  embedding_model: embedding-3                               # 向量化模型（智谱 embedding-3）
  embedding_dimensions: 512                                  # 向量维度（512 够用且快，embedding-3 支持）
