    {
      "id": "12_cit_test",
      "dir": "12_cit_test",
      "title": "CIT test execution",
      "kb_doc": "EXP-CIT-009",
      "kb_file": "EXP-CIT-009-CIT测试执行人工门禁与证据归档_2026-08-29.md",
      "executor": "agent",
      "required_outputs": ["output/result_{bug_id}.json"],
