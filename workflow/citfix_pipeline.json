    },
    {
      "id": "13_human_gate",
      "dir": "13_human_gate",
      "title": "Human gate",
      "kb_doc": "EXP-CIT-009",
      "kb_file": "EXP-CIT-009-CIT测试执行人工门禁与证据归档_2026-08-29.md",
