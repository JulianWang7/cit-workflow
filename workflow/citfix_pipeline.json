{
  "schema_version": "1.0",
  "pipeline_id": "citfix",
  "trigger": "/citfix {bug_id}",
  "description": "CIT automation pipeline entry. Workflow refinement in progress; stages EXP-CIT-004..011",
  "entry_modes": {
    "citfix_direct": {
      "description": "Start from bug id (/citfix 97203); skip req-table stages 01-02",
      "skip_stages": ["01_req_parse", "02_bug_task_extract"]
    }
  },
  "paths": {
    "repo_root": "D:/Workspace/cit-workflow",
    "test_bed_root": "D:/Workspace/cit-workflow-test",
    "kb_pipeline_root": "D:/Workspace/GDocuments/embedded-workflow-lab/knowledge-base/topics/cit/cit-automation-pipeline"
  },
  "cit_title_gate": {
    "enabled": true,
    "pattern": "CIT|【CIT】|\\[CIT问题\\]"
  },
  "stages": [
    {
      "id": "00_run_registry",
      "dir": "00_runs",
      "title": "Run registry",
