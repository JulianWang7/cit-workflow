    {
      "id": "14_closure",
      "dir": "14_closure",
      "title": "Closure",
      "kb_doc": "EXP-CIT-011",
      "kb_file": "EXP-CIT-011-CIT闭环通知角色工具与实施路线_2026-08-29.md",
      "executor": "agent",
      "required_outputs": ["output/closure_{bug_id}.json"],
